                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Admin status management. Use processing/cancelled from paid or pending according to workflow rules. Paid status is controlled only by payment workflow.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"{{order_status}}\",\n  \"note\": \"{{order_status_note}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/admin/orders/{{order_id}}/status"
          }
        }
      ],
      "description": "Admin-friendly endpoints to manage all orders.\n\nUse an admin token. Admins can view all orders and move orders through operational statuses.\nCancellation does not delete the order and does not automatically refund money; refund integration must be handled by payment-provider refund APIs."
    },
